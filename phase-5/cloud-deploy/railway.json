{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": {
    "backend": {
      "source": {
        "repo": "github.com/your-repo/todo-app",
        "branch": "main",
        "rootDirectory": "phase-5/backend"
      },
      "variables": {
        "PORT": "8000",
        "JWT_ALGORITHM": "HS256",
        "ACCESS_TOKEN_EXPIRE_HOURS": "24"
      },
      "deploy": {
        "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT"
      }
    },
    "frontend": {
      "source": {
        "repo": "github.com/your-repo/todo-app",
        "branch": "main",
        "rootDirectory": "phase-5/frontend"
      },
      "variables": {
        "PORT": "3000"
      },
      "deploy": {
        "startCommand": "npm start"
      }
    },
    "mcp-server": {
      "source": {
        "repo": "github.com/your-repo/todo-app",
        "branch": "main",
        "rootDirectory": "phase-5/mcp-server"
      },
      "variables": {
        "PORT": "5000",
        "LLM_MODEL": "openai/gpt-3.5-turbo"
      },
      "deploy": {
        "startCommand": "python server.py"
      }
    },
    "postgres": {
      "plugin": "postgresql"
    },
    "redis": {
      "plugin": "redis"
    }
  }
}

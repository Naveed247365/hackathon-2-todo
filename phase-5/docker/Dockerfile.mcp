# Dockerfile for Phase-5 MCP Server
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY phase-5/mcp-server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY phase-5/mcp-server/ .

# Expose MCP server port
EXPOSE 5000

# Run Flask server (production mode)
CMD ["python", "-c", "from server import app; app.run(host='0.0.0.0', port=5000, debug=False)"]

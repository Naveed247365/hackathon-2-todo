# Dockerfile for Phase-5 Next.js Frontend
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY phase-5/frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy application source
COPY phase-5/frontend/ .

# Build arguments for environment variables
ARG NEXT_PUBLIC_API_URL=http://localhost:30001
ARG NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:30003

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_MCP_SERVER_URL=${NEXT_PUBLIC_MCP_SERVER_URL}

# Build Next.js application
RUN npm run build

# Runtime stage
FROM node:18-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy build artifacts
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "start"]

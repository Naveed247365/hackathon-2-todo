# MCP Server Environment Variables for Kubernetes
# Copy to mcp-server.env and replace placeholders with actual values

# Backend URL (use service DNS name in Kubernetes)
BACKEND_URL=http://backend-service:8000

# MCP Server Configuration
MCP_PORT=5000

# API Keys (Secret - OpenRouter API key)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LLM Model Configuration
LLM_MODEL=openai/gpt-3.5-turbo

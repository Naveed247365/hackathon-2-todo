# Backend Environment Variables for Kubernetes
# Copy to backend.env and replace placeholders with actual values

# Database (Secret - Neon PostgreSQL connection string)
DATABASE_URL=postgresql://username:password@host.neon.tech:5432/database?sslmode=require

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS Configuration (use frontend service DNS name in Kubernetes)
CORS_ORIGINS=http://frontend-service:3000

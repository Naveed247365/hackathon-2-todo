# Kubernetes Secret Template
# IMPORTANT: Copy this file to secret.yaml and replace placeholders with actual values
# DO NOT commit secret.yaml to git - it contains sensitive credentials

apiVersion: v1
kind: Secret
metadata:
  name: todo-secrets
  namespace: default
type: Opaque
stringData:
  # Backend secrets
  DATABASE_URL: "postgresql://username:password@host.neon.tech:5432/database?sslmode=require"
  JWT_SECRET: "your-secret-key-change-in-production-use-openssl-rand-hex-32"

  # MCP Server secrets
  OPENROUTER_API_KEY: "your-openrouter-api-key-here"
